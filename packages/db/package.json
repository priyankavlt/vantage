{
  "name": "@vantage/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "App metadata database: Drizzle schema, client and migrations.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
