    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@vantage/eslint-config": "workspace:*",
    "@vantage/tsconfig": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0"
