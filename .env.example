# App metadata database (docker compose provides this locally)
DATABASE_URL=postgres://vantage:vantage@localhost:5432/vantage

# 32-byte key, base64. Encrypts data source credentials at rest.
# Generate: openssl rand -base64 32
VANTAGE_ENCRYPTION_KEY=

# Auth (better-auth). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# API server
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# Web -> API (server-side proxy target)
API_URL=http://localhost:4000
