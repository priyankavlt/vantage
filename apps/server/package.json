{
  "name": "@vantage/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Vantage API: auth, data sources, query execution, dashboards.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "auth generate --config auth.cli.ts --output ../../packages/db/src/schema/auth.ts --yes && prettier --write ../../packages/db/src/schema/auth.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@vantage/connectors": "workspace:*",
    "@vantage/db": "workspace:*",
    "@vantage/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vantage/eslint-config": "workspace:*",
    "@vantage/tsconfig": "workspace:*",
    "auth": "1.7.14",
    "eslint": "^10.13.0",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15"
  }
}
